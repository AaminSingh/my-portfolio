# Database Configuration (Optional MongoDB / Firebase)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio
FIREBASE_PROJECT_ID=my-portfolio-app

# Cloud Storage Configuration (Optional AWS S3 / Firebase Storage)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=my-portfolio-assets
